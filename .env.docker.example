# docker-compose 용 환경변수. 이 파일을 복사해 같은 폴더에 `.env` 로 저장하세요.
# docker compose 는 같은 디렉터리의 .env 파일을 자동으로 읽습니다.

# PostgreSQL 비밀번호 (원하는 값으로 변경 권장)
POSTGRES_PASSWORD=lifipedia

# NAS 를 LAN 에서만 쓸 경우: http://<NAS의 IP>:3000
# 도메인/리버스프록시(HTTPS)를 쓴다면 그 주소로. 소셜 로그인 콜백 URL 계산에 쓰인다.
NEXTAUTH_URL=http://192.168.0.2:3000

# 세션 암호화 키. 아래 명령으로 생성해서 넣으세요.
#   openssl rand -base64 32
NEXTAUTH_SECRET=change-me

# 월간/연간 스냅샷, 생애주기 정리 배치 API 보호용 토큰 (Cron 컨테이너/스케줄러에서 사용)
CRON_SECRET=change-me

# 테마 정식 승격에 필요한 팔로워 수
THEME_PROMOTION_THRESHOLD=20

# 컨테이너 밖으로 노출할 포트 (NAS 에서 이미 3000번을 쓰고 있다면 변경)
APP_PORT=3000

# 소셜 로그인을 쓸 경우에만 채우기 (없으면 로그인 버튼이 안내 문구로 대체됨)
GITHUB_ID=
GITHUB_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
